# Tree whose brain is edited (resolved by suite_core.knowledge). Empty = the device's default instance.
# LIFE_INSTANCE=
# Overrides, only when the tree layout does not apply:
# BRAIN_ROOT=
# AREAS_FILE=            # default: <instance>/config/brain-editor-areas.json, else config/areas.example.json
# OPEN_QUESTIONS_NOTE=   # note of the open-questions register, relative to brain/; empty = no register
APP_PORT=8035
# Access: `gate` (Life gate, default) or the name of a local provider in backend/app/local/.
# AUTH_PROVIDER=gate
# LIFE_OPERATOR_URL=     # operator portal that answers /api/people/me for the gate token
# Local login provider only (a module of backend/app/local/, not shipped here): DB, JWT secret, SSO cookie.
# DATABASE_URL=postgresql://<user>:<password>@localhost:5432/<db>
# JWT_SECRET=
# JWT_EXPIRE_MINUTES=480
# SSO_COOKIE_DOMAIN=
# SSO_SECRET=
